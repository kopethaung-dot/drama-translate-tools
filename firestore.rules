rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /jobs/{jobId} {
      // Anyone with the jobId can read status/results (no login flow, same
      // as the other tools) — but only the Cloud Functions (Admin SDK,
      // which bypasses these rules) may write.
      allow read: if true;
      allow write: if false;
    }
  }
}
